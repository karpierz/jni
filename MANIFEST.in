include README.rst
include CHANGES.rst
include LICENSE
include pyproject.toml
include noxfile.py

graft docs
# recursive-exclude docs *.*_

graft include
exclude include/**/*.txt
exclude include/**/*.dsc.txt

graft src
# recursive-exclude src/jni *.*_

graft tests
# recursive-exclude tests *.*_

global-exclude \#* \#*/**
global-exclude .build .build/** .build.* .build.*/**
global-exclude *.py[cod] __pycache__ .mypy_cache
