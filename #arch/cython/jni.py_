JNIEnv_ = cy.struct(
    functions = const JNINativeInterface_*,
)

#
# JNI Invocation Interface.
#

JNIInvokeInterface_ = cy.struct()

JavaVM = cy.const(cy.pointer(JNIInvokeInterface_))
class JavaVM:

    __itself_or_null = itself_or_null

    def _handle_JNIException(self, err):
        import sys
        fun_name = sys._getframe(1).f_code.co_name
        raise JNIException(err, info=fun_name)

    def DestroyJavaVM(self):
        jvm = self
        fun = self.functions[0]
        ret = fun.DestroyJavaVM(jvm)
        if ret != JNI_OK: self._handle_JNIException(ret)

    def AttachCurrentThread(self, penv, args=None):
        jvm = self
        fun = self.functions[0]
        ret = fun.AttachCurrentThread(jvm, penv, JavaVM.__itself_or_null(args))
        if ret != JNI_OK: self._handle_JNIException(ret)

    def AttachCurrentThreadAsDaemon(self, penv, args=None):
        jvm = self
        fun = self.functions[0]
        ret = fun.AttachCurrentThreadAsDaemon(jvm, penv, JavaVM.__itself_or_null(args))
        if ret != JNI_OK: self._handle_JNIException(ret)

    def DetachCurrentThread(self) -> None:
        jvm = self
        fun = self.functions[0]
        ret = fun.DetachCurrentThread(jvm)
        if ret != JNI_OK: self._handle_JNIException(ret)

    def GetEnv(self, penv: Pointer[Pointer[JNIEnv]], version: jint | int) -> None:
        jvm = self
        fun = self.functions[0]
        ret = fun.GetEnv(jvm, penv, version)
        if ret != JNI_OK: self._handle_JNIException(ret)

def JVM(pjvm: POINTER(JavaVM)) -> JavaVM:
    jvm = JavaVM()
    jvm._JavaVM__jvm = pjvm
    jvm.functions    = pjvm
    return jvm

# optionString may be any option accepted by the JVM, or one of the
# following:
#
# -D<name>=<value>          Set a system property.
# -verbose[:class|gc|jni]   Enable verbose output, comma-separated. E.g.
#                           "-verbose:class" or "-verbose:gc,class"
#                           Standard names include: gc, class, and jni.
#                           All nonstandard (VM-specific) names must begin
#                           with "X".
# vfprintf                  extraInfo is a pointer to the vfprintf hook.
# exit                      extraInfo is a pointer to the exit hook.
# abort                     extraInfo is a pointer to the abort hook.
#
JavaVMOption = cy.struct(
    optionString = cy.p_char,
    extraInfo    = cy.p_void,
)

JavaVMInitArgs = cy.struct(
    version            = jint,
    nOptions           = jint,
    options            = cy.pointer(JavaVMOption),
    ignoreUnrecognized = jboolean,
)

JavaVMAttachArgs = cy.struct(
    version =  jint,
    name    =  cy.p_char,
    group   =  jobject,
)

# These will be VM-specific.

JDK1_2: int = cy.const_int(1)
JDK1_4: int = cy.const_int(1)

# End VM-specific.

JNIInvokeInterface_ = cy.struct(
    reserved0 = cy.p_void,
    reserved1 = cy.p_void,
    reserved2 = cy.p_void,

    DestroyJavaVM       = jint (*)(JavaVM* vm),  # nogil
    AttachCurrentThread = jint (*)(JavaVM* vm, cy.pp_void penv, cy.p_void args),  # nogil
    DetachCurrentThread = jint (*)(JavaVM* vm),  # nogil
    GetEnv              = jint (*)(JavaVM* vm, cy.pp_void penv, jint version),  # nogil
    AttachCurrentThreadAsDaemon = jint (*)(JavaVM* vm, cy.pp_void penv, cy.p_void args),  # nogil
)

JavaVM_ = cy.struct(
    functions = const JNIInvokeInterface_*,
)

JNI_VERSION_1_1: int = cy.const_int(0x00010001)
JNI_VERSION_1_2: int = cy.const_int(0x00010002)
JNI_VERSION_1_4: int = cy.const_int(0x00010004)
JNI_VERSION_1_6: int = cy.const_int(0x00010006)
JNI_VERSION_1_8: int = cy.const_int(0x00010008)
JNI_VERSION_9:   int = cy.const_int(0x00090000)
JNI_VERSION_10:  int = cy.const_int(0x000a0000)
JNI_VERSION_19:  int = cy.const_int(0x00130000)
JNI_VERSION_20:  int = cy.const_int(0x00140000)
JNI_VERSION_21:  int = cy.const_int(0x00150000)
JNI_VERSION_24:  int = cy.const_int(0x00180000)

# eof jni.h
