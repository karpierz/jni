def JEnv(penv: POINTER(JNIEnv)):
    jenv = JNIEnv()
    jenv._JNIEnv__env = penv
    jenv.functions    = penv
    return jenv

JNINativeInterface_ = cy.struct(
    reserved0 = cy.p_void,
    reserved1 = cy.p_void,
    reserved2 = cy.p_void,
    reserved3 = cy.p_void,

    GetVersion                    = jint                 (*)(cy.pointer(JNIEnv) env)

    DefineClass                   = jclass               (*)(cy.pointer(JNIEnv) env, cy.p_const_char name, jobject loader, const jbyte *buf, jsize len)
    FindClass                     = jclass               (*)(cy.pointer(JNIEnv) env, cy.p_const_char name)

    FromReflectedMethod           = jmethodID            (*)(cy.pointer(JNIEnv) env, jobject method)
    FromReflectedField            = jfieldID             (*)(cy.pointer(JNIEnv) env, jobject field)

    ToReflectedMethod             = jobject              (*)(cy.pointer(JNIEnv) env, jclass cls, jmethodID methodID, jboolean isStatic)

    GetSuperclass                 = jclass               (*)(cy.pointer(JNIEnv) env, jclass sub)
    IsAssignableFrom              = jboolean             (*)(cy.pointer(JNIEnv) env, jclass sub, jclass sup)

    ToReflectedField              = jobject              (*)(cy.pointer(JNIEnv) env, jclass cls, jfieldID fieldID, jboolean isStatic)

    Throw                         = jint                 (*)(cy.pointer(JNIEnv) env, jthrowable obj)
    ThrowNew                      = jint                 (*)(cy.pointer(JNIEnv) env, jclass clazz, cy.p_const_char msg)
    ExceptionOccurred             = jthrowable           (*)(cy.pointer(JNIEnv) env)
    ExceptionDescribe             = void                 (*)(cy.pointer(JNIEnv) env)
    ExceptionClear                = void                 (*)(cy.pointer(JNIEnv) env)
    FatalError                    = void                 (*)(cy.pointer(JNIEnv) env, cy.p_const_char msg)

    PushLocalFrame                = jint                 (*)(cy.pointer(JNIEnv) env, jint capacity)
    PopLocalFrame                 = jobject              (*)(cy.pointer(JNIEnv) env, jobject result)

    NewGlobalRef                  = jobject              (*)(cy.pointer(JNIEnv) env, jobject lobj)
    DeleteGlobalRef               = void                 (*)(cy.pointer(JNIEnv) env, jobject gref)
    DeleteLocalRef                = void                 (*)(cy.pointer(JNIEnv) env, jobject obj)
    IsSameObject                  = jboolean             (*)(cy.pointer(JNIEnv) env, jobject obj1, jobject obj2)
    NewLocalRef                   = jobject              (*)(cy.pointer(JNIEnv) env, jobject ref)
    EnsureLocalCapacity           = jint                 (*)(cy.pointer(JNIEnv) env, jint capacity)

    AllocObject                   = jobject              (*)(cy.pointer(JNIEnv) env, jclass clazz)
    NewObject                     = jobject              (*)(cy.pointer(JNIEnv) env, jclass clazz, jmethodID methodID),  # ...),
    NewObjectV                    = jobject              (*)(cy.pointer(JNIEnv) env, jclass clazz, jmethodID methodID, va_list args)
    NewObjectA                    = jobject              (*)(cy.pointer(JNIEnv) env, jclass clazz, jmethodID methodID, const jvalue *args)

    GetObjectClass                = jclass               (*)(cy.pointer(JNIEnv) env, jobject obj)
    IsInstanceOf                  = jboolean             (*)(cy.pointer(JNIEnv) env, jobject obj, jclass clazz)

    GetMethodID                   = jmethodID            (*)(cy.pointer(JNIEnv) env, jclass clazz, cy.p_const_char name, cy.p_const_char sig)

